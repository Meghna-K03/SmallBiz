{
  "name": "smallbiz-lens-server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:counts": "tsx scripts/db-counts.ts",
    "analyze:data": "tsx scripts/analyze-data.ts",
    "analyze:competitive": "tsx scripts/analyze-data.ts --competitive-only",
    "verify:api": "tsx scripts/smoke-api.ts",
    "verify:forecast": "tsx scripts/validate-forecast.ts",
    "test:pure": "tsx --test --test-concurrency=1 test/forecasting.test.ts test/priority.test.ts test/aiGrounding.test.ts test/externalData.test.ts test/competitive.test.ts test/shopComparison.test.ts test/password.test.ts test/formatDays.test.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
