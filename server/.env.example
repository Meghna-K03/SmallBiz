# Supabase PostgreSQL. Copy this file to .env and fill in real values.
# Never commit .env.
# Runtime queries (transaction-mode pooler)
DATABASE_URL=
# Prisma migrations and seeding (session-mode pooler)
DIRECT_URL=
PORT=5000

# Groq AI explanations (optional; falls back to a plain explanation without a key)
GROQ_API_KEY=
# Optional model override
GROQ_MODEL=openai/gpt-oss-20b
