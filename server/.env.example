# Supabase PostgreSQL. Copy this file to .env and fill in real values.
# Never commit .env.
# Runtime queries (transaction-mode pooler)
DATABASE_URL=
# Prisma migrations and seeding (session-mode pooler)
DIRECT_URL=
PORT=5000

# Groq AI explanations (optional; falls back to a plain explanation without a key)
GROQ_API_KEY=
# Optional model override
GROQ_MODEL=openai/gpt-oss-20b

# Optional: folder with the competitive-price CSVs (default: ../data_csv, else ./data_csv)
COMPETITIVE_DATA_DIR=
# Optional: path to an imported official Government price file (see data/external/README.md)
EXTERNAL_PRICES_CSV=
